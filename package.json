{
  "name": "homebridge-actronair-neo",
  "displayName": "ActronAir Neo",
  "type": "module",
  "version": "1.0.1",
  "description": "Homebridge plugin for ActronAir Neo air conditioning systems",
  "author": "Ruaan Deysel",
  "license": "Apache-2.0",
  "homepage": "https://github.com/ruaan-deysel/homebridge-actronair-neo#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ruaan-deysel/homebridge-actronair-neo.git"
  },
  "bugs": {
    "url": "https://github.com/ruaan-deysel/homebridge-actronair-neo/issues"
  },
  "keywords": [
    "homebridge-plugin",
    "supports-hap",
    "actronair",
    "actron air",
    "neo",
    "actronair neo",
    "air conditioning"
  ],
  "main": "dist/index.js",
  "files": [
    "config.schema.json",
    "dist",
    "homebridge-ui",
    "src"
  ],
  "engines": {
    "homebridge": "^2.0.0",
    "node": "^22 || ^24"
  },
  "scripts": {
    "build": "rimraf ./dist && tsc",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "watch": "npm run build && npm link && nodemon",
    "prepublishOnly": "npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "@homebridge/plugin-ui-utils": "^2.0.0",
    "mqtt": "^5.15.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.2.0",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.0",
    "homebridge": "^2.0.0",
    "nodemon": "^3.1.14",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "brace-expansion": ">=5.0.8"
  }
}
